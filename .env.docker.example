# ============================================================
# 政策监测系统 Docker 部署环境变量示例
# 使用方法：复制本文件为 .env，然后修改对应配置值
# ============================================================

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_NAME=public_info_sync
DB_PORT=5432

# 完整的数据库连接 URL（app 服务使用）
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:your_strong_password_here@postgres:5432/public_info_sync

# 数据库连接池大小（生产环境建议 20）
PG_POOL_MAX=20

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
APP_PORT=3000
NODE_ENV=production
TZ=Asia/Shanghai

# ------------------------------------------------------------
# 安全配置
# ------------------------------------------------------------
# 写操作管理令牌（POST/PUT/DELETE）
# 建议用 openssl rand -hex 32 生成随机值
ADMIN_TOKEN=please_change_this_to_a_secure_random_token

# ------------------------------------------------------------
# LLM 大模型配置（可选，不填则使用规则版）
# ------------------------------------------------------------
# 以 OpenAI Chat Completions 协议为准，兼容 Mira / DeepSeek / 其他内部网关
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
