# =============================================================================
# Policy Radar · 政策雷达 — 本地开发环境变量示例
# -----------------------------------------------------------------------------
# 使用方式：复制为 .env.local，再按需填入真实值。
#   cp .env.local.example .env.local
# .env.local 已在 .gitignore 中排除，不会被提交。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 数据库（必填）
# -----------------------------------------------------------------------------
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>
# macOS 用 Homebrew 装的 PostgreSQL 一般是「系统用户名、无密码」
DATABASE_URL="postgresql://your_username@localhost:5432/policy_radar"

# 可选：连接池大小。默认 5；生产环境建议 20。
PG_POOL_MAX=5

# -----------------------------------------------------------------------------
# 2) 大模型（可选；不填会降级为关键词规则，不会崩）
# -----------------------------------------------------------------------------
# 任何 OpenAI Chat Completions 兼容接口都可以（DeepSeek、OpenAI 等）。
# 一般按用量付费，用的是你自己的 key。下面以 DeepSeek 为例：
#LLM_API_KEY=sk-your-key
#LLM_BASE_URL=https://api.deepseek.com
#LLM_MODEL=deepseek-chat
#LLM_TEMPERATURE=0.2
#LLM_MAX_TOKENS=800
# 用 OpenAI 时：LLM_BASE_URL=https://api.openai.com/v1，LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 3) 写操作鉴权 / 公开演示模式（可选）
# -----------------------------------------------------------------------------
# ADMIN_TOKEN：写操作（POST / PUT / DELETE）的管理口令。
# 不设置时本地开发不做鉴权。建议生成：openssl rand -hex 32
#ADMIN_TOKEN=change-me

# PUBLIC_DEMO=1：公开演示模式。访客只能浏览、搜索、用问答助手；
# 作者在 /unlock 页输入 ADMIN_TOKEN 后解锁全部功能。本地开发不要开。
#PUBLIC_DEMO=1
# 演示模式下访客问答助手每天最多调用大模型的次数（默认 100）
#DEMO_LLM_DAILY_LIMIT=100

# -----------------------------------------------------------------------------
# 4) 开发服务器（可选，仅 npm run dev）
# -----------------------------------------------------------------------------
# 想用手机等同一局域网设备访问 dev server 时，填允许的 host（逗号分隔，不带协议和端口）。
# 不填时会自动放行本机的局域网地址。
#NEXT_ALLOWED_DEV_ORIGINS=192.168.1.100,my-lan.local

# -----------------------------------------------------------------------------
# 5) 每日汇总推送（可选）
# -----------------------------------------------------------------------------
# 调用 POST /api/monitor/daily-summary 时，把近 24 小时的汇总推到下面的渠道。
#   DAILY_SUMMARY_WEBHOOK — 飞书 / 企业微信等机器人 webhook
#   DAILY_SUMMARY_EMAIL   — 逗号分隔的邮箱列表
#DAILY_SUMMARY_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
#DAILY_SUMMARY_EMAIL=you@example.com
