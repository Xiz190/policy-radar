# =============================================================================
# 部委公开信息监测台 — 本地开发环境变量示例
# -----------------------------------------------------------------------------
# 使用方式：复制此文件为 .env.local，并按需填入真实值。
#   cp .env.local.example .env.local
# 注意：
#   * .env.local 不要提交到 git（已在 .gitignore 中排除）
#   * 以 NEXT_PUBLIC_ 开头的变量会被嵌入到前端 bundle，仅用于非敏感配置
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 数据库
# -----------------------------------------------------------------------------
# PostgreSQL 连接串。默认假设本地 brew postgresql，
# 用当前系统用户名（例如 mac）无密码登录。
# 参考：postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://mac@localhost:5432/public_info_sync"

# 可选：连接池大小。默认 5；生产环境建议 20。
PG_POOL_MAX=5

# -----------------------------------------------------------------------------
# 2) 接口鉴权
# -----------------------------------------------------------------------------
# 写操作（POST / PUT / DELETE）管理令牌。
# 未设置时，本地开发默认关闭鉴权（仅用于本地）。
# 设置后，写操作通过服务端代理路由自动注入令牌。
# 建议生成：openssl rand -hex 32
ADMIN_TOKEN=change-me

# -----------------------------------------------------------------------------
# 3) 开发服务器（仅用于 `npm run dev`）
# -----------------------------------------------------------------------------
# 允许访问 HMR/WebSocket 的 host 白名单，逗号分隔，允许 * 使用常见局域网。
# 参考：next.config.ts 中的 resolveAllowedDevOrigins()
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,10.82.23.73

# -----------------------------------------------------------------------------
# 4) 大模型 / AI 分析（可选）
# -----------------------------------------------------------------------------
# 本项目支持两种接入方式，优先顺序为：
#   1) DOUBAO_*  — 字节豆包 SDK（已在 src/lib/ai/doubao.ts 声明，但默认为
#                  离线占位实现；如需真实接入，参考 lib/ai/doubao.ts 内说明补齐）
#   2) LLM_*     — 通用 OpenAI Chat Completions 兼容协议（Mira / DeepSeek /
#                  内部网关等）
#                  src/lib/ai/policy-analyzer.ts、src/lib/monitor/role-analysis.ts、
#                  src/app/api/chat/answer/route.ts 都会读取这套变量
# 都未配置时，代码会自动降级到关键词规则（不会崩）。

# —— 豆包 SDK 凭证（保留，用于未来接入）——
DOUBAO_API_KEY=your_api_key_here
DOUBAO_SECRET_KEY=your_secret_key_here

# —— OpenAI 兼容协议（推荐、当前实际生效）——
# 从 https://platform.openai.com/ 获取，或从内部网关/Mira/DeepSeek 获取
#LLM_API_KEY=sk-xxxx
# 默认为 https://api.openai.com/v1 ；使用 Mira 网关时可改为 https://mira.byted.org/v1
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_TEMPERATURE=0.2
#LLM_MAX_TOKENS=800
# 兜底别名：有些脚本也会读 OPENAI_API_KEY（与 LLM_API_KEY 二选一即可）
#OPENAI_API_KEY=sk-xxxx

# -----------------------------------------------------------------------------
# 5) 每日汇总推送（可选）
# -----------------------------------------------------------------------------
# 访问 POST /api/monitor/daily-summary 会生成近 24h 的汇总并推送到以下渠道。
# 至少设置一个才能真发送；两个都设置则会同时发。
#   * DAILY_SUMMARY_WEBHOOK — 飞书/企业微信/Teams 等 webhook URL
#   * DAILY_SUMMARY_EMAIL   — 逗号分隔的邮箱列表
#DAILY_SUMMARY_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
#DAILY_SUMMARY_EMAIL=ops-a@example.com,ops-b@example.com
