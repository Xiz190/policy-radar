## 本地开发示例（macOS brew postgresql）
# 你的本机用户名一般就是系统用户名，例如 mac
DATABASE_URL="postgresql://mac@localhost:5432/public_info_sync"

## 可选：连接池大小（默认 5，生产环境建议 20）
PG_POOL_MAX=5

## 可选：写操作管理令牌（POST/PUT/DELETE）。
# 不设置则关闭鉴权（仅本地开发用）；设置后每个写操作必须在请求头带：
#   Authorization: Bearer <ADMIN_TOKEN>
# 建议用 openssl rand -hex 32 生成一串随机值
# ADMIN_TOKEN=change-me

## 可选：接入大模型（把规则问答升级为"先检索再生成"）。
# 以 OpenAI Chat Completions 协议为准，兼容 Mira / DeepSeek / 其他内部网关。
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800

## 可选：dev server 允许的来源（逗号分隔）
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.100,my-lan.local

